# ═══════════════════════════════════════════════════════════════
# BACKEND - Variables de Entorno (Plantilla)
# ═══════════════════════════════════════════════════════════════
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env (mismo directorio)
# 2. Reemplaza los valores xxx con tus credenciales reales
# 3. NUNCA hagas commit de .env (añádelo a .gitignore)
#

# ═══════════════════════════════════════════════════════════════
# GEMINI (Google) - API PRINCIPAL
# ═══════════════════════════════════════════════════════════════
# Obtener en: https://ai.google.dev/
# 1. Click "Get API Key"
# 2. Crea/selecciona proyecto en Google Cloud
# 3. Copia la API key generada
#
GEMINI_API_KEY=xxx_tu_gemini_api_key_aqui_xxx

# ═══════════════════════════════════════════════════════════════
# STABILITY AI - FALLBACK (Opcional)
# ═══════════════════════════════════════════════════════════════
# Obtener en: https://platform.stability.ai/
# Gratuito: 25 imágenes/día sin tarjeta
#
STABILITY_API_KEY=xxx_tu_stability_api_key_aqui_xxx

# ═══════════════════════════════════════════════════════════════
# PUERTO Y ENTORNO
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE GENERACIÓN DE IMÁGENES
# ═══════════════════════════════════════════════════════════════
# Tamaño de imagen (opciones: 256, 512, 1024)
IMAGE_SIZE=512
# Número máximo de reintentos si falla la API
MAX_RETRIES=2
# Timeout en ms para esperar respuesta de API
API_TIMEOUT=30000
