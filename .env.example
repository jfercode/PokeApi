# =====================================================
# PokeAPI Full Stack - Environment variables
# =====================================================

# ═══════════════════════════════════════════════════════
# FRONTEND CONFIGURATION (app/.env)
# ═══════════════════════════════════════════════════════

VITE_FRONTEND_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:3000

# APIs
VITE_POKEAPI_BASE=https://pokeapi.co/api/v2
# Get API Key from: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=

# localStorage Keys
VITE_STORAGE_KEY_FUSIONS=pokemonFusions

# OAuth2 (Frontend)
# Get Google Client ID from: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Go to APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add http://localhost:5173 to Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=
VITE_OAUTH_CALLBACK=http://localhost:3000/api/auth/callback

# ═══════════════════════════════════════════════════════════════
# BACKEND - Variables de Entorno (REAL - NO HACER COMMIT)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# STABILITY AI
# ═══════════════════════════════════════════════════════════════
# Get API Key from: https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# ═══════════════════════════════════════════════════════════════
# PORTS AND ENVIRONMENT
# ═══════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# OAUTH2 - Google Configuration
# ═══════════════════════════════════════════════════════════════
# Get Google Client ID & Secret from: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Go to APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add http://localhost:3000 and http://localhost:5173 to Authorized origins
# 5. Copy Client ID and Secret below
GOOGLE_CLIENT_ID=
# Get Google Client Secret from the same place as Client ID
GOOGLE_CLIENT_SECRET=
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════
# JWT Configuration
# ═══════════════════════════════════════════════════════════════
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d


